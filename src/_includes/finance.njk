---
layout: base.njk
pageCss: finance.css
extraHead: |
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
tabsA11y: true   # base.njk 據此以 cssBust 載入 /tabs-a11y.js（extraHead 是純字串，寫在這裡的 {{ }} 不會展開）
extraScripts: |
  // 把 .month-nav 搬到 .header 之後（nav 在模板渲染於 content 前，需移到 header 下方）
  (function relocateNav(){
    var nav = document.querySelector('.month-nav');
    var header = document.querySelector('.header');
    if (nav && header && header.nextSibling !== nav) {
      header.parentNode.insertBefore(nav, header.nextSibling);
    }
  })();
  // 頁籤無障礙漸進增強由共用 /tabs-a11y.js 處理（extraHead 以 defer 載入；長期財務模型也用同一份）
---
{%- set fnav = collections | getFinancePager(page.url) %}
{%- if fnav %}
<div class="month-nav no-print">
{%- if fnav.prev %}
  <a href="{{ fnav.prev.url }}">← {{ fnav.prev.data.title | replace(' 財務月報', '') }}</a>
{%- else %}
  <span></span>
{%- endif %}
{%- if fnav.next %}
  <a href="{{ fnav.next.url }}">{{ fnav.next.data.title | replace(' 財務月報', '') }} →</a>
{%- else %}
  <span></span>
{%- endif %}
</div>
{%- endif %}
{{ content | safe }}
{% if pdfUrl %}
<style>
/* 原始財報 PDF 橫幅樣式。刻意寫在 HTML 內（隨頁面出貨），不放 finance.css——
   因為 .css 會被 Cloudflare／瀏覽器邊緣快取，CSS 改了住戶端可能還拿到舊版，
   橫幅就會「有文字、沒樣式」。HTML 不被快取，inline style 永遠是新的。 */
.pdf-banner {
  display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-12) var(--sp-16);
  margin: 0 0 var(--sp-28); padding: var(--sp-16) var(--sp-20);
  background: var(--tint); border: 1px solid var(--line);
  border-left: 3px solid var(--blue); border-radius: 8px;
  font-size: var(--fs-text); color: var(--wg11);
}
.pdf-banner .pdf-banner-label { display: inline-flex; align-items: center; gap: var(--sp-8); }
.pdf-banner a {
  display: inline-flex; align-items: center; gap: var(--sp-8);
  padding: var(--sp-8) var(--sp-16); font-size: var(--fs-text); font-weight: 700;
  color: var(--wg1); background: var(--blue);
  border-radius: 6px; text-decoration: none; letter-spacing: var(--ls-text);
  transition: opacity .18s;
}
.pdf-banner a:hover { opacity: .85; }
@media (max-width: 600px) { .pdf-banner { padding: var(--sp-12) var(--sp-16); } }
@media print {
  .pdf-banner { border-left-color: var(--wg11); background: var(--tint); }
  .pdf-banner a { color: var(--wg41); background: transparent; border: 1px solid var(--wg11); padding: 2px var(--sp-8); }
}
</style>
<script>
/* 有原始財報 PDF 時，於內容區頂端自動插入連結橫幅（單頁分享給住戶時也看得到原始檔）。
   逐月維護由 frontmatter 的 pdfUrl 控制，模板只渲染一次，所有月報自動套用。 */
(function () {
  var url = "{{ pdfUrl }}";
  var main = document.querySelector(".main");
  if (!url || !main) return;
  var bar = document.createElement("div");
  bar.className = "pdf-banner";
  bar.innerHTML =
    '<span class="pdf-banner-label">📄 本頁為原始財務報表之數位彙整，原始檔（含完整收支明細）可於此查閱：</span>' +
    '<a href="' + url + '" target="_blank" rel="noopener">↓ 檢視／下載原始財報 PDF</a>';
  main.insertBefore(bar, main.firstChild);
})();
</script>
{% endif %}
